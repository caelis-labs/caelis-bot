t","type":"string"}},"required":["type","trigger","event"],"type":"object"}]}},"required":["request"],"type":"object"}},{"name":"bot_schedule_update","description":"Save/remove a user-requested calendar reminder or event-based standing arrangement; configure changes the care interruption budget only on explicit user request. Stable IDs retain existing native grants/receipts. Save returns actual timing/state; accepted registration is not delivery. No shell schedulers, arbitrary event publishing, or budget bypass. Read the reminders/care guide for timing and limits.","inputSchema":{"additionalProperties":false,"properties":{"request":{"anyOf":[{"additionalProperties":false,"properties":{"id":{"pattern":"^[A-Za-z0-9_-]{1,64}$","type":"string"},"label":{"maxLength":160,"minLength":1,"type":"string"},"prompt":{"maxLength":4096,"minLength":1,"type":"string"},"trigger":{"anyOf":[{"additionalProperties":false,"properties":{"schedule":{"anyOf":[{"additionalProperties":false,"properties":{"at":{"description":"One-off RFC3339 timestamp with offset","type":"string"},"type":{"const":"at","type":"string"}},"required":["type","at"],"type":"object"},{"additionalProperties":false,"properties":{"everyMinutes":{"maximum":10080,"minimum":1,"type":"integer"},"type":{"const":"interval","type":"string"}},"required":["type","everyMinutes"],"type":"object"},{"additionalProperties":false,"properties":{"daily":{"description":"HH:MM","type":"string"},"type":{"const":"daily","type":"string"}},"required":["type","daily"],"type":"object"},{"additionalProperties":false,"properties":{"times":{"items":{"description":"HH:MM","type":"string"},"maxItems":48,"minItems":1,"type":"array","uniqueItems":true},"type":{"const":"times","type":"string"}},"required":["type","times"],"type":"object"}]},"timeZone":{"maxLength":128,"minLength":1,"type":"string"},"type":{"const":"calendar","type":"string"},"weekdays":{"items":{"maximum":7,"minimum":1,"type":"integer"},"maxItems":7,"type":"array","uniqueItems":true},