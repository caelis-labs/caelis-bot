n.","inputSchema":{"additionalProperties":false,"properties":{"request":{"anyOf":[{"additionalProperties":false,"properties":{"machine":{"maxLength":256,"minLength":1,"type":"string"},"prompt":{"maxLength":24000,"minLength":1,"type":"string"},"requestId":{"pattern":"^[A-Za-z0-9_-]{8,128}$","type":"string"},"title":{"maxLength":160,"minLength":1,"type":"string"},"type":{"const":"start","type":"string"},"workspace":{"description":"Optional absolute existing project directory; omitted creates a managed workspace","type":"string"}},"required":["type","requestId","prompt"],"type":"object"},{"additionalProperties":false,"properties":{"prompt":{"maxLength":24000,"minLength":1,"type":"string"},"requestId":{"pattern":"^[A-Za-z0-9_-]{8,128}$","type":"string"},"task":{"maxLength":256,"minLength":1,"type":"string"},"type":{"const":"continue","type":"string"}},"required":["type","requestId","task","prompt"],"type":"object"}]}},"required":["request"],"type":"object"}},{"name":"bot_interactions","description":"Inspect and resolve native Worker approvals and asynchronous questions. Use current offered options and exact request IDs. Answer from known task context or ask the user when unclear. Runtime remains authoritative; never decide this Bot's own approval or retry an unknown result.","inputSchema":{"additionalProperties":false,"properties":{"request":{"anyOf":[{"additionalProperties":false,"properties":{"type":{"const":"list","type":"string"}},"required":["type"],"type":"object"},{"additionalProperties":false,"properties":{"answers":{"additionalProperties":{"items":{"maxLength":16384,"minLength":1,"type":"string"},"type":"array"},"type":"object"},"approval":{"maxLength":256,"minLength":1,"type":"string"},"choice":{"maxLength":256,"minLength":1,"type":"string"},"type":{"const":"decide","type":"string"}},"required":["type","approval","choice"],"type":"object"},{"additionalProperties":false,"properties":{"question":{"maxLength":32,"minLength":1,"type":"string"},"requestId":{"patter